            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{auth_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/watch-list?sort=latest",
                  "host": ["{{base_url}}"],
                  "path": ["watch-list"],
                  "query": [
                    {
                      "key": "sort",
                      "value": "latest"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Watch list retrieved successfully\",\n  \"data\": {\n    \"watch_list\": [\n      {\n        \"id\": 1,\n        \"user_id\": 1,\n        \"car_listing_id\": 2,\n        \"notes\": \"Great car, considering purchase\",\n        \"notifications_enabled\": true,\n        \"price_when_added\": 25895.00,\n        \"viewed_at\": \"2024-01-15T10:30:00Z\",\n        \"view_count\": 5,\n        \"car_listing\": {\n          \"id\": 2,\n          \"title\": \"2022 Hyundai Kona SEL\",\n          \"price\": 25895.00,\n          \"year\": 2022,\n          \"mileage\": 89000,\n          \"brand\": {\n            \"name\": \"Hyundai\"\n          },\n          \"car_model\": {\n            \"name\": \"Kona\"\n          },\n          \"media\": [\n            {\n              \"url\": \"https://example.com/image1.jpg\",\n              \"type\": \"image\"\n            }\n          ],\n          \"badges\": [\n            {\n              \"name\": \"Warranty\",\n              \"color\": \"purple\"\n            },\n            {\n              \"name\": \"Inspected\",\n              \"color\": \"green\"\n            }\n          ]\n        }\n      }\n    ],\n    \"total\": 2,\n    \"per_page\": 20,\n    \"current_page\": 1,\n    \"last_page\": 1,\n    \"count\": 2\n  }\n}"
            }
