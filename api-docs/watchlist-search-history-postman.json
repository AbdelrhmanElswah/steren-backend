  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set variables if not provided",
          "if (!pm.variables.get('favorite_id')) {",
          "    pm.variables.set('favorite_id', '1'); // Default favorite ID for testing",
          "}",
          "if (!pm.variables.get('search_id')) {",
          "    pm.variables.set('search_id', '1'); // Default search ID for testing",
          "}",
          "if (!pm.variables.get('sort_option')) {",
          "    pm.variables.set('sort_option', 'latest'); // Default sort option",
          "}",
          "if (!pm.variables.get('page')) {",
          "    pm.variables.set('page', '1'); // Default page",
          "}",
          "if (!pm.variables.get('saved_only')) {",
          "    pm.variables.set('saved_only', 'true'); // Default to saved searches only",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test response structure",
          "pm.test('Response has success field', function () {",
          "    pm.expect(pm.response.json()).to.have.property('success');",
          "});",
          "",
          "pm.test('Response has message field', function () {",
          "    pm.expect(pm.response.json()).to.have.property('message');",
          "});",
          "",
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "// Log response for debugging",
          "console.log('Response:', pm.response.json());"
        ]
      }
    }
  ]
}
