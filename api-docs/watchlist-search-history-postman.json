  "item": [
    {
      "name": "Watchlist",
      "item": [
        {
          "name": "Get Watchlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/watch-list?sort={{sort_option}}&page={{page}}",
              "host": ["{{base_url}}"],
              "path": ["watch-list"],
              "query": [
                {
                  "key": "sort",
                  "value": "{{sort_option}}",
                  "description": "latest, recently_viewed, price_high, price_low, year_high, year_low, mileage_high, mileage_low"
                },
                {
                  "key": "page",
                  "value": "{{page}}",
                  "description": "Page number for pagination"
                }
              ]
            },
            "description": "Get user's watchlist with sorting and pagination options"
          },
